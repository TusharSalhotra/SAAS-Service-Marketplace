{
  "name": "registration-form",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:next": "WATCHPACK_POLLING=true next dev apps/web -H 0.0.0.0",
    "dev:api": "nest start --watch -p apps/api/tsconfig.json",
    "dev:full": "concurrently \"npm run dev:next\" \"npm run dev:api\"",
    "build:next": "next build apps/web",
    "api:build": "nest build -p apps/api/tsconfig.json",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.13",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.13",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.0.13",
    "@vitejs/plugin-react": "^4.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "concurrently": "^9.1.2",
    "helmet": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.487.0",
    "mongoose": "^8.12.1",
    "next": "^15.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^17.7.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4"
  }
}
